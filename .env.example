POSTGRES_DB=solo_harness
POSTGRES_USER=solo_harness
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://solo_harness:change-me@postgres:5432/solo_harness
APP_ENV=production
STUDY_DIR=/app/studies/networks_error_detection_parity_f1/v0.5
ACTIVATE_STUDY_ON_BOOTSTRAP=true
LLM_PROVIDER=aicredits_openai_compatible
AICREDITS_BASE_URL=
AICREDITS_API_KEY=
LLM_STRUCTURED_OUTPUT_MODE=provider_native_json_schema
TUTOR_MODEL=
JUDGE_MODEL=
TUTOR_TEMPERATURE=0.2
JUDGE_TEMPERATURE=0
TUTOR_MAX_OUTPUT_TOKENS=6000
JUDGE_MAX_OUTPUT_TOKENS=6000
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_STALE_GRACE_SECONDS=30
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BUILD_ID=dev
LOG_LEVEL=INFO
IDEMPOTENCY_RETENTION_SECONDS=43200
RESEARCH_DATA_DIR=/app/research-data
REQUIRE_ACTIVE_CAPTURE=false
ACTIVE_CAPTURE_MAX_AGE_SECONDS=300
PARTICIPANT_STUDY_TITLE=Learning study
PARTICIPANT_INTRO_TEXT=You will complete four guided learning sections. Each section includes a teaching conversation, a brief mental-effort rating, and an independent assessment. # CHANGED
PARTICIPANT_PRIVACY_TEXT=Replace this with the approved privacy, consent, withdrawal, and data-use statement.
PARTICIPANT_SUPPORT_TEXT=Replace this with researcher contact and participant support instructions.

# CHANGED: set true to activate the complete controlled C1-C4 study (v0.5 source).
# For that mode, also set STUDY_DIR=/app/studies/networks_error_detection_parity_f1/v0.5
ENABLE_V051_UNIFIED_STUDY=true

# Legacy token-protected internal pilot endpoint. Keep disabled outside controlled work.
ENABLE_V051_INTERNAL_TESTING=false
V051_INTERNAL_TESTING_TOKEN=
# The Master Console is available without a separate login only when APP_ENV=development.
WEB_SESSION_SECRET=

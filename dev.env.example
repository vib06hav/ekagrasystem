# Optional overrides for compose.dev.yaml. Copy to dev.env only when you need
# non-default local development credentials or ports; this file contains no secrets.
EKAGRA_DEV_DB_NAME=ekagra_dev
EKAGRA_DEV_DB_USER=ekagra_dev
EKAGRA_DEV_DB_PASSWORD=replace-with-a-local-dev-password
EKAGRA_DEV_DB_PORT=55433
EKAGRA_DEV_APP_PORT=18080
EKAGRA_DEV_SESSION_SECRET=replace-with-a-local-dev-session-secret

# Teaching and live Judge calls remain opt-in. Leave blank for no paid live LLM calls.
EKAGRA_DEV_AICREDITS_BASE_URL=
EKAGRA_DEV_AICREDITS_API_KEY=
EKAGRA_DEV_TUTOR_MODEL=
EKAGRA_DEV_JUDGE_MODEL=
